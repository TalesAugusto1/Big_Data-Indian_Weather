# Copy to ".env" in the repo root (do not commit .env).
# Optional overrides for docker-compose.yml.
#
# Hadoop/YARN/MapReduce (memória, FS, filas) → editar docker/hadoop.env
#   (ver comentários no topo desse ficheiro).

# Hadoop NameNode cluster name (shown in HDFS UI)
CLUSTER_NAME=bigdata-lab

# Optional: isolate compose project name on shared machines
# COMPOSE_PROJECT_NAME=bigdata-indian-weather

# Published host ports (defaults match docs/stack-apache.md)
# NAMENODE_HTTP_PORT=9870
# NAMENODE_RPC_PORT=9000
# DATANODE_HTTP_PORT=9864
# YARN_RM_HTTP_PORT=8088
# YARN_NM_HTTP_PORT=8042
# YARN_HISTORYSERVER_HTTP_PORT=8188
# SPARK_MASTER_WEB_PORT=8080
# SPARK_MASTER_PORT=7077
# SPARK_WORKER_WEB_PORT=8081

# Jupyter — URL do master Spark VISTO PELO KERNEL (por defeito no compose: local[4] no contentor).
# Para correr com executors no spark-worker (Standalone), descomente:
# JUPYTER_SPARK_MASTER=spark://spark-master:7077
# e recrie o serviço: docker compose up -d --force-recreate notebook
# (exige RAM suficiente no Docker; ver docker/README.md troubleshooting 5).

# Jupyter — heap do driver em local[4] (Compose já passa 3g por defeito; aumente só se o host tiver RAM).
# SPARK_DRIVER_MEMORY=4g
# SPARK_DRIVER_MAX_RESULT_SIZE=1g
# SPARK_DEFAULT_PARALLELISM=4
# SPARK_SQL_SHUFFLE_PARTITIONS=8

# Jupyter — limite de linhas no decision_tree.ipynb (randomSplit varre tudo; None no host = dataset completo).
# DTR_NOTEBOOK_MAX_ROWS=800000

# Jupyter (só modo cluster) — limites no spark-worker
# SPARK_EXECUTOR_MEMORY=1g
# SPARK_EXECUTOR_CORES=1
# SPARK_CORES_MAX=4
