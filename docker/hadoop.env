# =============================================================================
# docker/hadoop.env — Configuração Hadoop / HDFS / YARN / MapReduce (lab M01)
# =============================================================================
#
# O que é este ficheiro?
# -----------------------
# As imagens **bde2020** (hadoop-namenode, datanode, resourcemanager, …) usam
# um *entrypoint* que lê variáveis de ambiente e gera os ficheiros XML do
# Hadoop em runtime (core-site.xml, hdfs-site.xml, yarn-site.xml, mapred-site.xml).
# Assim evitamos montar XML manualmente no repositório.
#
# Convenção de nomes (importante para ler/editar)
# ------------------------------------------------
#   <SITE>_CONF_<propriedade_hadoop>
#
#   SITE indica o ficheiro XML gerado:
#     CORE_CONF_*   → core-site.xml    (FS por defeito, utilizador HTTP, codecs)
#     HDFS_CONF_*   → hdfs-site.xml    (WebHDFS, permissões, checks do NameNode)
#     YARN_CONF_*   → yarn-site.xml    (ResourceManager, NodeManager, timeline)
#     MAPRED_CONF_* → mapred-site.xml  (MapReduce sobre YARN, memória dos jobs)
#
#   Cada **___** (três underscores) no nome corresponde a um **.** (ponto)
#   na chave Hadoop original.
#
#   Exemplo:
#     YARN_CONF_yarn_log___aggregation___enable=true
#       ↔  yarn.log-aggregation-enable = true   (em yarn-site.xml)
#
#   Algumas chaves usam **__** (dois underscores) onde o *upstream* bde2020
#   já assim o define (ex.: resource__tracker); não altere sem comparar com
#   a documentação das imagens.
#
# Relação com o nosso docker-compose
# ------------------------------------
#   • fs.defaultFS aponta para hdfs://namenode:9000 → alinhado com o serviço
#     `namenode` na rede Docker `bigdata`.
#   • Hostnames yarn.resourcemanager.* = `resourcemanager`, timeline =
#     `historyserver` → têm de bater certo com os **container_name** no compose.
#
# Documentação de operação (subir / logs / troubleshooting):
#   → docker/README.md
#
# =============================================================================
# Perfil da máquina (leitura automática em 2026-04-21 — reajuste se mudar de PC)
# =============================================================================
#
#   Detetado neste host:
#     • RAM instalada ≈ 32 GB (WMI TotalPhysicalMemory)
#     • RAM disponível no momento da leitura ≈ 19 GB (varia com a carga)
#     • CPU: AMD Ryzen 7 5800X — 16 threads lógicos
#     • Disco C: ~1,2 TB livres (WMI FreeSpace)
#
#   Estratégia de afinação:
#     • Reservar ~8–10 GB ao Windows, Docker Desktop e IDE.
#     • Empurrar o NodeManager para **8192 MB** (teto de oferta de RAM no nó).
#     • Teto do CapacityScheduler **6144 MB** (sempre ≤ NM; evita pedidos impossíveis).
#     • Map/reduce com mais heap do que o perfil “laptop 8 GB”, mas ainda abaixo
#       dos defaults agressivos do upstream docker-hadoop.
#     • **vcores NM = 8** e scheduler max **4** (metade dos threads: deixa CPU ao SO,
#       Spark, GC e containers HDFS/RM).
#
# =============================================================================
# Guia rápido — o que mexer se algo “morre” por memória
# =============================================================================
#
#   1) Desça YARN_CONF_yarn_nodemanager_resource_memory___mb (NodeManager).
#   2) Desça MAPRED_CONF_mapreduce_*_memory_mb e os -Xmx* em *_java_opts.
#   3) Desça YARN_CONF_yarn_scheduler_capacity_root_default_maximum___allocation___mb
#      para não pedir mais RAM ao NM do que ele pode dar.
#   4) docker compose down -v && docker compose up -d  (apaga dados HDFS locais)
#
#   Se **mudar de computador**, apague o bloco “Perfil da máquina” acima ou
#   regrave os números após nova leitura (não há deteção em runtime neste ficheiro).
#
# =============================================================================

# ----------------------------------------------------------------------------- 
# 1) CORE — core-site.xml (ficheiro por defeito no HDFS, utilizador da UI)
# ----------------------------------------------------------------------------- 
# fs.defaultFS: onde *todos* os clientes HDFS procuram dados (NameNode + RPC).
# hadoop.http.staticuser.user: utilizador mostrado nas UIs WebHDFS/Jupyter Hue.
# proxyuser.* : necessário se usar Hue ou proxies; seguro para laboratório.

CORE_CONF_fs_defaultFS=hdfs://namenode:9000
CORE_CONF_hadoop_http_staticuser_user=root
CORE_CONF_hadoop_proxyuser_hue_hosts=*
CORE_CONF_hadoop_proxyuser_hue_groups=*
CORE_CONF_io_compression_codecs=org.apache.hadoop.io.compress.SnappyCodec

# ----------------------------------------------------------------------------- 
# 2) HDFS — hdfs-site.xml (WebHDFS, permissões, registo DataNode → NameNode)
# ----------------------------------------------------------------------------- 
# dfs.webhdfs_enabled: permite REST/WebHDFS (útil para testes e ferramentas).
# dfs.permissions_enabled=false: simplifica o lab (não usar em produção).
# registration.ip-hostname-check=false: evita falhas quando o DataNode vê
#   hostnames Docker em vez de IPs “clássicos”.

HDFS_CONF_dfs_webhdfs_enabled=true
HDFS_CONF_dfs_permissions_enabled=false
HDFS_CONF_dfs_namenode_datanode_registration_ip___hostname___check=false

# ----------------------------------------------------------------------------- 
# 3) YARN — yarn-site.xml (filas, RM, NM, logs agregados, timeline)
# ----------------------------------------------------------------------------- 
# yarn.log-aggregation-enable + yarn.log.server-url: após jobs, logs vão para
#   o History Server (UI em :8188).
# recovery + FileSystemRMStateStore: RM guarda estado em HDFS (/rmstate).
# CapacityScheduler: scheduler por defeito em muitos clusters Hadoop 3.
# yarn.resourcemanager.hostname/address/*: tráfego interno entre RM ↔ NM.
# timeline.* : integração com histórico de aplicações (History Server).
# nodemanager.resource.memory/cpu: **teto** de recursos que cada NM oferece ao
#   cluster — parâmetro crítico para OOM em máquinas pequenas.
# nodemanager.aux-services=mapreduce_shuffle: necessário para shuffle MR/Spark
#   quando jobs correm em YARN.

YARN_CONF_yarn_log___aggregation___enable=true
YARN_CONF_yarn_log_server_url=http://historyserver:8188/applicationhistory/logs/
YARN_CONF_yarn_resourcemanager_recovery_enabled=true
YARN_CONF_yarn_resourcemanager_store_class=org.apache.hadoop.yarn.server.resourcemanager.recovery.FileSystemRMStateStore
YARN_CONF_yarn_resourcemanager_scheduler_class=org.apache.hadoop.yarn.server.resourcemanager.scheduler.capacity.CapacityScheduler
YARN_CONF_yarn_scheduler_capacity_root_default_maximum___allocation___mb=6144
YARN_CONF_yarn_scheduler_capacity_root_default_maximum___allocation___vcores=4
YARN_CONF_yarn_resourcemanager_fs_state___store_uri=/rmstate
YARN_CONF_yarn_resourcemanager_system___metrics___publisher_enabled=true
YARN_CONF_yarn_resourcemanager_hostname=resourcemanager
YARN_CONF_yarn_resourcemanager_address=resourcemanager:8032
YARN_CONF_yarn_resourcemanager_scheduler_address=resourcemanager:8030
YARN_CONF_yarn_resourcemanager_resource__tracker_address=resourcemanager:8031
YARN_CONF_yarn_timeline___service_enabled=true
YARN_CONF_yarn_timeline___service_generic___application___history_enabled=true
YARN_CONF_yarn_timeline___service_hostname=historyserver
YARN_CONF_mapreduce_map_output_compress=true
YARN_CONF_mapred_map_output_compress_codec=org.apache.hadoop.io.compress.SnappyCodec
YARN_CONF_yarn_nodemanager_resource_memory___mb=8192
YARN_CONF_yarn_nodemanager_resource_cpu___vcores=8
YARN_CONF_yarn_nodemanager_disk___health___checker_max___disk___utilization___per___disk___percentage=98.5
YARN_CONF_yarn_nodemanager_remote___app___log___dir=/app-logs
YARN_CONF_yarn_nodemanager_aux___services=mapreduce_shuffle

# ----------------------------------------------------------------------------- 
# 4) MAPRED — mapred-site.xml (MapReduce em cima do YARN e memória JVM)
# ----------------------------------------------------------------------------- 
# mapreduce.framework.name=yarn: jobs MapReduce (e porções do ecossistema) usam
#   YARN em vez de modo local.
# mapreduce.*.memory_mb / *java_opts: limites pedidos ao scheduler; devem ser
#   coerentes com o scheduler e com o NM acima.
# HADOOP_MAPRED_HOME: versão embebida nas imagens bde2020 (Hadoop 3.2.1).

MAPRED_CONF_mapreduce_framework_name=yarn
MAPRED_CONF_mapred_child_java_opts=-Xmx1536m
MAPRED_CONF_mapreduce_map_memory_mb=3072
MAPRED_CONF_mapreduce_reduce_memory_mb=6144
MAPRED_CONF_mapreduce_map_java_opts=-Xmx2560m
MAPRED_CONF_mapreduce_reduce_java_opts=-Xmx5120m
MAPRED_CONF_yarn_app_mapreduce_am_env=HADOOP_MAPRED_HOME=/opt/hadoop-3.2.1/
MAPRED_CONF_mapreduce_map_env=HADOOP_MAPRED_HOME=/opt/hadoop-3.2.1/
MAPRED_CONF_mapreduce_reduce_env=HADOOP_MAPRED_HOME=/opt/hadoop-3.2.1/
